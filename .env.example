# --- Server ---------------------------------------------------------------
PORT=3000
# Public HTTPS origin the QR codes point at (no trailing slash).
PUBLIC_BASE_URL=https://orders.example.com
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
DATA_DIR=./data
DATABASE_PATH=./data/224.db
DISPLAY_TIMEZONE=Asia/Bangkok

# --- Telegram (secrets: keep server-side only) -----------------------------
TELEGRAM_BOT_TOKEN=
# Private staff group chat ID (negative number for groups, e.g. -1001234567890).
TELEGRAM_STAFF_CHAT_ID=
# Random string (A-Z a-z 0-9 _ -, 1-256 chars) used for webhook verification.
TELEGRAM_WEBHOOK_SECRET=

# Bearer token protecting /api/internal/* (receipt regeneration).
INTERNAL_API_TOKEN=

# --- Venue / receipt ------------------------------------------------------
VENUE_NAME=224 LIVE HOUSE
# Lines separated by |
VENUE_ADDRESS_LINES=
VENUE_PHONE=
# Only set these if you are legally registered and want them printed.
VENUE_TAX_ID=
RECEIPT_TITLE=SALES RECEIPT
RECEIPT_WIDTH_MM=80
# Venue logo for the top of the receipt (PNG/JPEG, ideally black on white).
# Defaults to assets/receipt-logo.png; a built-in "224" mark is used if absent.
RECEIPT_LOGO_PATH=assets/receipt-logo.png
RECEIPT_CUSTOMER_DOWNLOAD=true

# --- Billing policy -------------------------------------------------------
# Basis points (1000 = 10%). Leave 0 if not applicable; nothing is invented.
SERVICE_CHARGE_BPS=0
VAT_BPS=0
PAYMENT_METHODS=Cash,PromptPay

# --- Customer access ------------------------------------------------------
VISIT_TOKEN_TTL_HOURS=12
PIN_MAX_FAILED_ATTEMPTS=10
